# Kök .env — yalnızca `tools/verify_live.py` (canlı erişilebilirlik sondası) kullanır.
# Kopyala: `copy .env.example .env` — .env'i paylaşma, depoya ekleme.
# Her projenin kendi .env.example'ı ayrıdır (uygulama eşiklerini de içerir).

# --- Zorunlu (canlı mod) ------------------------------------------------------
# RapidAPI > Nokia Network as Code > SIMULATOR planı > "X-RapidAPI-Key"
NAC_RAPIDAPI_KEY=
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com

# --- passthrough/ uçları için Bearer -----------------------------------------
# İki yol var; birini doldur:
#  (a) portaldan aldığın hazır access token'ı doğrudan yaz
NAC_OAUTH_TOKEN=
#  (b) ya da client-credentials bilgilerini ver — sonda token'ı kendisi alır.
#      TOKEN_URL değerini Nokia portalındaki uygulama ayarlarından kopyala.
NAC_OAUTH_TOKEN_URL=
NAC_OAUTH_CLIENT_ID=
NAC_OAUTH_CLIENT_SECRET=
NAC_OAUTH_SCOPE=

# --- Sonda ayarları -----------------------------------------------------------
# SIMULATOR planında hangi test numaralarının tanımlı olduğunu portal belgelerinden
# bak; buraya onlardan birini yaz. Boşsa +905551234567 denenir.
NAC_PROBE_PHONE=

# Abonelik uçlarını (--include-write) denemek için sink public HTTPS olmalı:
#   ngrok http 8000   →   PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Ajan planlayıcı (HeatShield) — MENA Ignite Resource & Tooling Guide araçları
# Anahtar YOKSA sistem deterministik kurallarla çalışır; model bir iyileştirmedir, bağımlılık değil.
# ---------------------------------------------------------------------------
# Google AI Studio (ücretsiz anahtar): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (düşük gecikme yolu, ücretsiz anahtar): https://console.groq.com/keys
GROQ_API_KEY=
# rules | gemini | groq | auto   (varsayılan auto: anahtar varsa model, yoksa kurallar)
HS_PLANNER=auto
# Model adları (varsayılanlar yeterli)
HS_GEMINI_MODEL=gemini-2.0-flash
HS_GROQ_MODEL=llama-3.3-70b-versatile
# Model çağrısı zaman aşımı (sn) — aşılırsa kuralların sırası uygulanır
HS_PLANNER_TIMEOUT_S=6

# ---------------------------------------------------------------------------
# Ajanın kendi saati (HeatShield zamanlayıcısı)
# Kadans mantığı `agent.policy.sweep_due()` içinde; bu görev onu gerçekten çağırır.
# Varsayılan: testte ve fixture modunda KAPALI (demolar belirlenimci kalsın).
# ---------------------------------------------------------------------------
HS_SCHEDULER=0
HS_SCHEDULER_TICK_S=30

# İllüstratif sorgu birim maliyeti (USD). BOŞ BIRAKILIRSA HİÇ DOLAR RAKAMI ÜRETİLMEZ.
# Bu bir Nokia fiyatı ya da operatör teklifi DEĞİLDİR; yalnızca kendi fiyat listenizle
# çalışmak isterseniz doldurun. Doldurulursa çıktı açıkça "illustrative" diye etiketlenir.
HS_QUERY_UNIT_COST_USD=
