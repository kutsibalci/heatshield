# HeatShield configuration. Copy to `.env` (`copy .env.example .env`); never share or commit `.env`.
# The API reads it at start-up; the live tools in tools/ read it too (and only run with --live).
# fixture and simulator modes, the demos and the test suite need none of these values.

# --- Required (live mode) -----------------------------------------------------
# RapidAPI > Nokia Network as Code > SIMULATOR plan > "X-RapidAPI-Key"
NAC_RAPIDAPI_KEY=
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com

# --- Bearer for passthrough/ endpoints ---------------------------------------
# There are two ways; fill in one:
#  (a) write the ready-made access token you got from the portal directly
NAC_OAUTH_TOKEN=
#  (b) or provide the client-credentials details — the probe obtains the token itself.
#      Copy the TOKEN_URL value from the application settings in the Nokia portal.
NAC_OAUTH_TOKEN_URL=
NAC_OAUTH_CLIENT_ID=
NAC_OAUTH_CLIENT_SECRET=
NAC_OAUTH_SCOPE=

# --- Probe settings -----------------------------------------------------------
# Check the portal documentation for which test numbers are defined on the SIMULATOR plan;
# write one of them here. If empty, +99999000001000 is tried.
NAC_PROBE_PHONE=

# To try the subscription endpoints (--include-write), the sink must be public HTTPS:
#   ngrok http 8000   →   PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Secrets — they have NO defaults in the repo. If left empty, they are generated randomly per process;
# NAC_MODE=live does NOT START without these three.
# ---------------------------------------------------------------------------
# Admin: site/worker/WBGT/sweep/reset and personal-data reads (Authorization: Bearer ...)
HS_API_TOKEN=
# Only the operator's geofence notifications (given to the subscription as sinkCredential)
WEBHOOK_TOKEN=
# Phone number hash (HMAC-SHA256). If it changes, old hashes no longer match.
PHONE_HASH_SALT=

# fixture | simulator | live
NAC_MODE=fixture
# 1 → the six demo scenarios are enabled (resets the store, personal-data reads enabled). Rejected in live mode.
HS_DEMO_MODE=0
# Demo run limit: per IP per minute (0 = unlimited)
HS_DEMO_RATE_PER_MIN=20
# QA | SA | AE — default jurisdiction for new sites
HS_JURISDICTION=QA

# ---------------------------------------------------------------------------
# Agent planner (HeatShield) — tools from the MENA Ignite Resource & Tooling Guide
# WITHOUT a key the system runs on deterministic rules; the model is an improvement, not a dependency.
# ---------------------------------------------------------------------------
# Google AI Studio (free key): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (low-latency path, free key): https://console.groq.com/keys
GROQ_API_KEY=
# rules | gemini | groq | auto   (default auto: the model if there is a key, otherwise the rules)
HS_PLANNER=auto
# Model names (the defaults are sufficient)
HS_GEMINI_MODEL=gemini-flash-latest
HS_GROQ_MODEL=openai/gpt-oss-20b
# Model call timeout (s) — if exceeded, the rules' order is applied
HS_PLANNER_TIMEOUT_S=6

# ---------------------------------------------------------------------------
# The agent's own clock (HeatShield scheduler)
# The cadence logic lives in `agent.policy.sweep_due()`; this task actually calls it.
# Default: OFF in tests and in fixture mode (so the demos stay deterministic).
# ---------------------------------------------------------------------------
HS_SCHEDULER=0
HS_SCHEDULER_TICK_S=30

# Illustrative per-query unit cost (USD). IF LEFT EMPTY, NO DOLLAR FIGURE IS PRODUCED AT ALL.
# This is NOT a Nokia price or an operator quote; fill it in only if you want to work
# with your own price list. If filled in, the output is clearly labelled "illustrative".
HS_QUERY_UNIT_COST_USD=
